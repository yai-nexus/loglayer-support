{
  "name": "@yai-loglayer/next",
  "version": "0.8.2",
  "description": "Next.js 统一日志组件 - 集成server和browser优化方案",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "logging",
    "nextjs",
    "server",
    "browser",
    "typescript",
    "sls",
    "unified"
  ],
  "author": "YAI Team",
  "license": "MIT",
  "dependencies": {
    "loglayer": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "typescript": "^5.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "eslint": "^8.0.0"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0"
  },
  "files": [
    "dist",
    "client.ts",
    "server.ts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yai-nexus/loglayer-support.git",
    "directory": "packages/next"
  }
}
